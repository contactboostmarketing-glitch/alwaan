# URL publique du site (balises canoniques, sitemap)
NEXT_PUBLIC_SITE_URL=https://alwaan.fr
# Ouvrir l'indexation Google au lancement uniquement
SITE_INDEXABLE=false

# Shopify (recommandé) : back office, panier, paiement
# Domaine en .myshopify.com et jeton Storefront (Back office → Applications → Headless)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Remise exacte par panier (secret, uniquement dans Netlify) : application « Site alwaan »
# avec les étendues write_discounts et read_discounts
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ou, à la place, un jeton Admin direct
SHOPIFY_ADMIN_TOKEN=

# Assistant IA (comprend une demande écrite) : clé API Anthropic, secret
ANTHROPIC_API_KEY=

# Repli : paiement direct Stripe si Shopify n'est pas configuré
STRIPE_SECRET_KEY=
STRIPE_AUTOMATIC_TAX=false

# API Roly (secrets, uniquement dans Netlify)
ROLY_USERNAME=
ROLY_PASSWORD=
# Clé pour lancer le diagnostic et la synchronisation
ROLY_SYNC_KEY=

# --- Mesure des conversions (publicités) ---
NEXT_PUBLIC_GA4_ID=            # G-XXXXXXX (Google Analytics 4)
GA4_API_SECRET=                # GA4 → Admin → Flux de données → Secrets de l'API Measurement Protocol
NEXT_PUBLIC_GOOGLE_ADS_ID=     # AW-XXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=     # Pixel Meta
META_CAPI_TOKEN=               # Meta Events Manager → Paramètres → API Conversions → Générer un jeton
SHOPIFY_WEBHOOK_SECRET=        # facultatif : sinon le secret de l'application (SHOPIFY_CLIENT_SECRET) est utilisé

# --- Contact et entreprise (devis PDF) ---
NEXT_PUBLIC_WHATSAPP=          # ex. 33612345678 (sans + ni espaces)
NEXT_PUBLIC_PHONE=             # ex. 01 23 45 67 89
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_SIRET=
COMPANY_VAT=
COMPANY_EMAIL=
COMPANY_IBAN=                  # affiché sur le devis pour le paiement par virement
STAFF_KEY=                     # clé de l'espace atelier (sinon la clé de synchronisation)
